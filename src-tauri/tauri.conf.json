{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SlowClient",
  "version": "1.2.0",
  "identifier": "com.lightingplays.slowclient",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlowClient",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "../script/header.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "French"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "SlowClient"
      }
    }
  }
}
